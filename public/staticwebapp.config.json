{
  "routes": [
    { "route": "/app", "rewrite": "/app.html" },
    { "route": "/app/*", "rewrite": "/app.html" },
    { "route": "/privacy", "rewrite": "/privacy/index.html" },
    { "route": "/legal", "rewrite": "/legal/index.html" },
    { "route": "/cookies", "rewrite": "/cookies/index.html" },
    { "route": "/license", "rewrite": "/license/index.html" }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/icons/*",
      "/sw.js",
      "/manifest.webmanifest",
      "/app.html",
      "/privacy/*",
      "/legal/*",
      "/cookies/*",
      "/license/*",
      "/legal.css"
    ]
  },
  "globalHeaders": {
    "Cross-Origin-Opener-Policy": "same-origin",
    "Cross-Origin-Embedder-Policy": "require-corp",
    "Cross-Origin-Resource-Policy": "same-origin",
    "X-Content-Type-Options": "nosniff"
  }
}