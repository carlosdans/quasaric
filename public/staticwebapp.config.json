{
  "routes": [
    {
      "route": "/app",
      "rewrite": "/app.html"
    },
    {
      "route": "/app/*",
      "rewrite": "/app.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/icons/*",
      "/sw.js",
      "/manifest.webmanifest",
      "/app.html"
    ]
  },
  "globalHeaders": {
    "Cross-Origin-Opener-Policy": "same-origin",
    "Cross-Origin-Embedder-Policy": "require-corp",
    "Cross-Origin-Resource-Policy": "same-origin",
    "X-Content-Type-Options": "nosniff"
  }
}